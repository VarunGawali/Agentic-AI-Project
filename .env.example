# ── Required ──────────────────────────────────────────────────────────────────

# EIA API key for fetching WTI / Brent price history
EIA_API_KEY=your_eia_api_key_here

# ── Azure Blob Storage (optional — falls back to local data/ and models/) ─────

# Connection string for the Azure Storage account that holds market data
# and trained model artifacts
AZURE_STORAGE_CONNECTION_STRING=

# Container for price history CSVs (default: market-data)
BLOB_CONTAINER_NAME=market-data

# Container for trained model artifacts (default: ml-models)
MODEL_ARTIFACTS_CONTAINER=ml-models

# Override default blob names for model artifacts
XGB_MODEL_BLOB_NAME=xgb_drift_model.json
XGB_FEATURE_COLUMNS_BLOB_NAME=xgb_feature_columns.json
XGB_METADATA_BLOB_NAME=xgb_training_metadata.json

# ── Azure OpenAI (optional — deterministic fallback is active when not set) ───

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# ── Azure Key Vault (optional — for production secret management) ─────────────
# When set, secrets above are pulled from Key Vault instead of env vars.
# AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net/

# ── Runtime config ────────────────────────────────────────────────────────────

# Directory for model artifacts (default: models/)
MODEL_DIR=models

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
